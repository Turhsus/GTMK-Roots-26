[sub_resource type="Resource" id="Line_food_pass"]
script = ExtResource("2_line")
text = "The little one's first journey was long, but thankfully they were well fed enough to make the journey."
require_stat = {
"food": 2
}

[sub_resource type="Resource" id="Line_food_fail"]
script = ExtResource("2_line")
text = "There wasn't enough food to make the journey, so the little one had to turn back. They came back so hungry... don't let them go without rations again!"

[resource]
