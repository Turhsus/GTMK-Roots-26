script = ExtResource("3_lbn1t")
id = "wine_delivery"
title = "Wine Delivery"
brief = "The local tavern needs a new shipment of wine. Its a short walk, but there's been some fox banditry on the route lately who have a hankerin' for wine. Make sure to bring the wine, without breaking it, and a weapon to defend yourself."
