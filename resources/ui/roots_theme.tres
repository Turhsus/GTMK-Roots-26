[gd_resource type="Theme" load_steps=7 format=3]

[ext_resource type="StyleBox" path="res://resources/ui/panel_frame.tres" id="1_panel"]
[ext_resource type="StyleBox" path="res://resources/ui/button_normal.tres" id="2_btn_normal"]
[ext_resource type="StyleBox" path="res://resources/ui/button_hover.tres" id="3_btn_hover"]
[ext_resource type="StyleBox" path="res://resources/ui/button_pressed.tres" id="4_btn_pressed"]
[ext_resource type="StyleBox" path="res://resources/ui/button_disabled.tres" id="5_btn_disabled"]
[ext_resource type="StyleBox" path="res://resources/ui/button_focus.tres" id="6_btn_focus"]

; Project-wide default look. Applied via gui/theme/custom in project.godot,
; so every Control in every scene picks it up with no per-scene wiring.
;
; Label text here is LIGHT: bare labels sit on the dark ColorRect backdrops
; each screen uses. Labels inside a tan panel get dark text from
; panel_content_theme.tres, which is assigned on the PanelContainer itself.
[resource]
default_font_size = 20
Button/colors/font_color = Color(0.13, 0.1, 0.09, 1)
Button/colors/font_disabled_color = Color(0.13, 0.1, 0.09, 0.45)
Button/colors/font_focus_color = Color(0.13, 0.1, 0.09, 1)
Button/colors/font_hover_color = Color(0.09, 0.07, 0.06, 1)
Button/colors/font_pressed_color = Color(0.09, 0.07, 0.06, 1)
Button/styles/disabled = ExtResource("5_btn_disabled")
Button/styles/focus = ExtResource("6_btn_focus")
Button/styles/hover = ExtResource("3_btn_hover")
Button/styles/normal = ExtResource("2_btn_normal")
Button/styles/pressed = ExtResource("4_btn_pressed")
Label/colors/font_color = Color(0.9, 0.85, 0.78, 1)
Panel/styles/panel = ExtResource("1_panel")
PanelContainer/styles/panel = ExtResource("1_panel")
PopupPanel/styles/panel = ExtResource("1_panel")
